# Copy this file to .env.local and fill in your own values.

# Database (Neon or any Postgres)
NEXT_PUBLIC_DRIZZLE_DB_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js (generate a secret with: npx auth secret)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI and voice
OPENAI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Email
SENDGRID_API_KEY=
SENDGRID_VERIFIED_SENDER=
RESEND_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_UNLIMITED_PRICE_ID=

# App URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000

# Optional
NEXT_PUBLIC_ADZUNA_APP_ID=
NEXT_PUBLIC_ADZUNA_APP_KEY=
NEXT_PUBLIC_INTERVIEW_QUESTION_COUNT=5
